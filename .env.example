# =================================================================
# AWKWARD LEGACY - Configuration Environment Example
# =================================================================
# Description: Fichier d'exemple des variables d'environnement
# Version: 1.0
# Date: 17 Octobre 2025
# =================================================================
# IMPORTANT: Copier ce fichier vers .env et configurer les valeurs
# cp .env.example .env
# =================================================================

# =================================================================
# APPLICATION
# =================================================================

# Nom de l'application
APP_NAME=AWKWARD_LEGACY

# Environnement: development, staging, production
APP_ENV=production

# Mode debug (false en production)
APP_DEBUG=false

# Version de l'application
APP_VERSION=1.0.0

# =================================================================
# BASE DE DONNÉES
# =================================================================

# Chemin de la base de données principale
DATABASE_PATH=/data/db

# Chemin des backups
DATABASE_BACKUP_PATH=/data/backups

# PostgreSQL (optionnel si utilisé à la place de SQLite)
DB_CONNECTION=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=awkward_legacy
DB_USER=awkward
DB_PASSWORD=CHANGEME_STRONG_PASSWORD_HERE

# =================================================================
# SERVEUR WEB
# =================================================================

# Hôte et port d'écoute
HOST=0.0.0.0
PORT=8080

# Nombre de workers (processus)
WORKERS=4

# Timeout des requêtes (secondes)
REQUEST_TIMEOUT=60

# Taille max des uploads (en MB)
MAX_UPLOAD_SIZE=100

# =================================================================
# SÉCURITÉ
# =================================================================

# Clé secrète pour l'application (OBLIGATOIRE - CHANGER!)
# Générer avec: openssl rand -hex 32
SECRET_KEY=CHANGEME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# JWT Configuration
JWT_SECRET_KEY=CHANGEME_ANOTHER_RANDOM_KEY_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400  # 24 heures en secondes
JWT_REFRESH_EXPIRATION=604800  # 7 jours

# Encryption key (pour données sensibles)
# Générer avec: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGEME_GENERATE_FERNET_KEY_HERE

# Bcrypt rounds pour hashage des mots de passe
BCRYPT_ROUNDS=12

# CORS (domaines autorisés)
ALLOWED_HOSTS=localhost,awkward-legacy.com,www.awkward-legacy.com
ALLOWED_ORIGINS=https://awkward-legacy.com,https://www.awkward-legacy.com

# CSRF Protection
CSRF_ENABLED=true
CSRF_SECRET_KEY=CHANGEME_CSRF_SECRET_KEY

# =================================================================
# LOGGING
# =================================================================

# Niveau de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Fichier de log principal
LOG_FILE=/var/log/awkward/app.log

# Taille max du fichier de log (bytes)
LOG_MAX_BYTES=10485760  # 10 MB

# Nombre de fichiers de rotation
LOG_BACKUP_COUNT=5

# Format de log: json, text
LOG_FORMAT=json

# =================================================================
# RGPD / DONNÉES PERSONNELLES
# =================================================================

# Durée de rétention des données (jours)
DATA_RETENTION_DAYS=1095  # 3 ans

# Anonymisation automatique après (jours)
ANONYMIZE_AFTER_DAYS=1825  # 5 ans

# Suppression des comptes inactifs après (jours)
DELETE_INACTIVE_AFTER_DAYS=1095  # 3 ans

# Délai de grâce avant suppression (jours)
DELETION_GRACE_PERIOD=30

# =================================================================
# PERFORMANCE / CACHE
# =================================================================

# Cache activé
CACHE_ENABLED=true

# Type de cache: redis, memory, file
CACHE_TYPE=redis

# TTL du cache (secondes)
CACHE_TTL=3600  # 1 heure

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD
REDIS_MAX_CONNECTIONS=50

# Répertoire de cache (si type=file)
CACHE_DIR=/data/cache

# =================================================================
# EMAIL
# =================================================================

# Configuration SMTP
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=noreply@awkward-legacy.com
SMTP_PASSWORD=CHANGEME_SMTP_PASSWORD

# Adresse d'expédition
EMAIL_FROM=noreply@awkward-legacy.com
EMAIL_FROM_NAME=AWKWARD LEGACY

# Email de l'administrateur (pour notifications)
ADMIN_EMAIL=admin@awkward-legacy.com

# =================================================================
# SERVICES EXTERNES
# =================================================================

# AWS S3 (pour backups)
AWS_ACCESS_KEY_ID=CHANGEME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGEME_AWS_SECRET_KEY
AWS_S3_BUCKET=awkward-legacy-backups
AWS_REGION=eu-west-1

# Sentry (monitoring des erreurs)
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe (si paiements)
STRIPE_PUBLIC_KEY=pk_live_CHANGEME
STRIPE_SECRET_KEY=sk_live_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# Google Analytics (optionnel)
GA_TRACKING_ID=UA-XXXXXXXXX-X

# =================================================================
# MONITORING
# =================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME_GRAFANA_PASSWORD

# Health check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30  # secondes

# =================================================================
# NOTIFICATIONS
# =================================================================

# Slack webhook (pour notifications de déploiement)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email de notification
NOTIFICATION_EMAIL=ops@awkward-legacy.com

# =================================================================
# BACKUP
# =================================================================

# Configuration des backups automatiques
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Cron: tous les jours à 2h du matin
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=CHANGEME_BACKUP_ENCRYPTION_KEY

# Upload des backups vers S3
BACKUP_S3_ENABLED=true
BACKUP_S3_BUCKET=awkward-legacy-backups

# =================================================================
# DOMAINE / SSL
# =================================================================

# Domaine principal
DOMAIN=awkward-legacy.com

# Certificat SSL (Let's Encrypt)
LETSENCRYPT_EMAIL=ssl@awkward-legacy.com
LETSENCRYPT_STAGING=false  # true pour tests

# =================================================================
# DÉVELOPPEMENT (Désactiver en production)
# =================================================================

# Hot reload (dev only)
HOT_RELOAD=false

# SQL Echo (afficher les requêtes SQL)
SQL_ECHO=false

# Profiling
PROFILING_ENABLED=false

# Mock mode (pour tests)
MOCK_MODE=false

# =================================================================
# FEATURE FLAGS
# =================================================================

# Nouvelles fonctionnalités (activer/désactiver)
FEATURE_NEW_UI=true
FEATURE_ADVANCED_SEARCH=true
FEATURE_EXPORT_PDF=true
FEATURE_SOCIAL_LOGIN=false
FEATURE_TWO_FACTOR_AUTH=true
FEATURE_API_V2=false

# =================================================================
# RATE LIMITING
# =================================================================

# Limite de requêtes par IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Limite pour l'authentification (prévention brute force)
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW=900  # 15 minutes

# =================================================================
# LOCALISATION
# =================================================================

# Langue par défaut
DEFAULT_LANGUAGE=fr
AVAILABLE_LANGUAGES=fr,en,es,de

# Timezone
TIMEZONE=Europe/Paris

# Format de date
DATE_FORMAT=%d/%m/%Y
TIME_FORMAT=%H:%M:%S

# =================================================================
# MAINTENANCE
# =================================================================

# Mode maintenance (affiche une page de maintenance)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Maintenance en cours. Nous serons de retour bientôt.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,192.168.1.1

# =================================================================
# AUTRES
# =================================================================

# Taille de pagination par défaut
PAGINATION_SIZE=50

# Session timeout (secondes)
SESSION_TIMEOUT=3600  # 1 heure

# Nombre max de connexions simultanées
MAX_CONNECTIONS=100

# Activer les métriques
METRICS_ENABLED=true

# Mode verbose pour debug
VERBOSE=false

# =================================================================
# FIN DE LA CONFIGURATION
# =================================================================
# Note: Ne jamais commiter le fichier .env avec les vraies valeurs!
# Utiliser des outils comme git-secret ou ansible-vault pour la
# gestion sécurisée des secrets en production.
# =================================================================