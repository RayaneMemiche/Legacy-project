# =================================================================
# Environment Variables - AWKWARD LEGACY
# =================================================================
# Copier ce fichier vers .env et remplir les valeurs
# =================================================================

# -----------------------------------------------
# Application Configuration
# -----------------------------------------------
APP_NAME=awkward-legacy
APP_ENV=production
APP_DEBUG=false
APP_URL=https://awkward-legacy.com
PORT=5000

# -----------------------------------------------
# Flask Configuration
# -----------------------------------------------
FLASK_APP=lib.wserver
FLASK_ENV=production
SECRET_KEY=changeme_random_secret_key_min_32_chars

# -----------------------------------------------
# Database Configuration
# -----------------------------------------------
DATABASE_URL=postgresql://awkward:password@postgres:5432/awkward_legacy
DB_NAME=awkward_legacy
DB_USER=awkward
DB_PASSWORD=changeme
DB_HOST=postgres
DB_PORT=5432

# -----------------------------------------------
# Redis Configuration
# -----------------------------------------------
REDIS_URL=redis://:password@redis:6379/0
REDIS_PASSWORD=changeme
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------
# Security
# -----------------------------------------------
JWT_SECRET_KEY=changeme_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=changeme_encryption_key_32_bytes

# -----------------------------------------------
# CORS Configuration
# -----------------------------------------------
CORS_ORIGINS=https://awkward-legacy.com,https://www.awkward-legacy.com
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------
# File Upload
# -----------------------------------------------
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=/app/data/uploads
ALLOWED_EXTENSIONS=ged,gedcom,zip,txt

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3

# -----------------------------------------------
# Monitoring
# -----------------------------------------------
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# -----------------------------------------------
# Email (optionnel)
# -----------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@awkward-legacy.com

# -----------------------------------------------
# Backup Configuration
# -----------------------------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=changeme
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=awkward-legacy-backups
AWS_REGION=us-east-1

# -----------------------------------------------
# Grafana
# -----------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# -----------------------------------------------
# Deployment
# -----------------------------------------------
STAGING_HOST=staging.awkward-legacy.com
STAGING_USER=deploy
PRODUCTION_HOST=awkward-legacy.com
PRODUCTION_USER=deploy

# -----------------------------------------------
# Feature Flags
# -----------------------------------------------
FEATURE_RGPD_EXPORT=true
FEATURE_ADVANCED_SEARCH=true
FEATURE_API_V2=false

# -----------------------------------------------
# Rate Limiting
# -----------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------
# Cache Configuration
# -----------------------------------------------
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=awkward:

# -----------------------------------------------
# Session Configuration
# -----------------------------------------------
SESSION_TYPE=redis
SESSION_PERMANENT=true
SESSION_USE_SIGNER=true
PERMANENT_SESSION_LIFETIME=86400

# -----------------------------------------------
# Development Only
# -----------------------------------------------
FLASK_DEBUG=0
WERKZEUG_DEBUG_PIN=off
