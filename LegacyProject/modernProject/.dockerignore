.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation
docs/_build/
*.md
!README.md

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# Backups
backups/
*.bak
*~

