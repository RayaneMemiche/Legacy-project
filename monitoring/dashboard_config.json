{
  "dashboard": {
    "id": "awkward-legacy-main",
    "title": "AWKWARD LEGACY - Main Dashboard",
    "version": "1.0.0",
    "description": "Dashboard principal de monitoring pour AWKWARD LEGACY",
    "tags": ["production", "monitoring", "performance", "security"],
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  },
  "panels": [
    {
      "id": 1,
      "title": "System Overview",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"awkward-legacy\"}",
          "legendFormat": "Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "value": 1,
              "text": "🟢 Online"
            },
            {
              "type": "value",
              "value": 0,
              "text": "🔴 Offline"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "(time() - process_start_time_seconds{job=\"awkward-legacy\"}) / 86400",
          "legendFormat": "Days"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "days",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active Users",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "awkward_active_users",
          "legendFormat": "Users"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(awkward_api_errors_total[5m]) * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Request Rate",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(awkward_api_requests_total[1m])",
          "legendFormat": "Requests/sec"
        }
      ],
      "yaxes": [
        {
          "format": "reqps",
          "label": "Requests per second"
        }
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "colors": ["#5794F2"]
    },
    {
      "id": 6,
      "title": "Response Time",
      "type": "graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(awkward_api_latency_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(awkward_api_latency_bucket[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(awkward_api_latency_bucket[5m]))",
          "legendFormat": "P99"
        }
      ],
      "yaxes": [
        {
          "format": "ms",
          "label": "Response Time"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "colors": ["#73BF69", "#FADE2A", "#F2495C"]
    },
    {
      "id": 7,
      "title": "CPU Usage",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"awkward-legacy\"}[1m]) * 100",
          "legendFormat": "CPU %"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "CPU Usage",
          "max": 100
        }
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "colors": ["#B877D9"]
    },
    {
      "id": 8,
      "title": "Memory Usage",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"awkward-legacy\"} / 1024 / 1024",
          "legendFormat": "Memory (MB)"
        }
      ],
      "yaxes": [
        {
          "format": "mbytes",
          "label": "Memory"
        }
      ],
      "lines": true,
      "fill": 1,
      "linewidth": 2,
      "colors": ["#F2495C"]
    },
    {
      "id": 9,
      "title": "Database Connections",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "expr": "awkward_db_connections_active",
          "legendFormat": "Active"
        },
        {
          "expr": "awkward_db_connections_idle",
          "legendFormat": "Idle"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Connections"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "stack": true,
      "colors": ["#5794F2", "#73BF69"]
    },
    {
      "id": 10,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "awkward_cache_hits_total / (awkward_cache_hits_total + awkward_cache_misses_total) * 100",
          "legendFormat": "Hit Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Disk Usage",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 18
      },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes - node_filesystem_avail_bytes) / node_filesystem_size_bytes * 100",
          "legendFormat": "Disk %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 12,
      "title": "Top Endpoints",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "topk(5, sum by(endpoint) (rate(awkward_api_requests_total[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "columns": [
        {
          "text": "Endpoint",
          "value": "endpoint"
        },
        {
          "text": "Requests/sec",
          "value": "Value",
          "format": "reqps"
        }
      ]
    },
    {
      "id": 13,
      "title": "Security Events",
      "type": "graph",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "increase(awkward_security_events_total[1h])",
          "legendFormat": "{{event_type}}"
        }
      ],
      "bars": true,
      "lines": false,
      "stack": true,
      "colors": ["#F2495C", "#FF9830", "#FADE2A", "#73BF69"]
    },
    {
      "id": 14,
      "title": "RGPD Operations",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "increase(awkward_rgpd_operations_total[24h])",
          "format": "table",
          "instant": true
        }
      ],
      "columns": [
        {
          "text": "Operation",
          "value": "operation"
        },
        {
          "text": "Count (24h)",
          "value": "Value"
        }
      ]
    },
    {
      "id": 15,
      "title": "Service Health",
      "type": "heatmap",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "up{job=~\"awkward-.*\"}",
          "format": "heatmap"
        }
      ],
      "heatmap": {
        "colorScheme": "interpolateRdYlGn"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "text": "production",
            "value": "production"
          },
          {
            "text": "staging",
            "value": "staging"
          },
          {
            "text": "development",
            "value": "development"
          }
        ]
      },
      {
        "name": "interval",
        "type": "interval",
        "current": {
          "text": "1m",
          "value": "1m"
        },
        "options": [
          {
            "text": "1m",
            "value": "1m"
          },
          {
            "text": "5m",
            "value": "5m"
          },
          {
            "text": "15m",
            "value": "15m"
          },
          {
            "text": "1h",
            "value": "1h"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "query": "changes(awkward_deployment_info[5m]) > 0"
      },
      {
        "name": "Incidents",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "query": "awkward_incident_active == 1"
      }
    ]
  },
  "alerts": [
    {
      "name": "High Error Rate",
      "condition": "rate(awkward_api_errors_total[5m]) > 0.05",
      "severity": "critical",
      "notification": "slack"
    },
    {
      "name": "High Response Time",
      "condition": "histogram_quantile(0.95, rate(awkward_api_latency_bucket[5m])) > 0.5",
      "severity": "warning",
      "notification": "email"
    },
    {
      "name": "Low Cache Hit Rate",
      "condition": "awkward_cache_hits_total / (awkward_cache_hits_total + awkward_cache_misses_total) < 0.6",
      "severity": "warning",
      "notification": "email"
    },
    {
      "name": "High Memory Usage",
      "condition": "process_resident_memory_bytes / 1024 / 1024 / 1024 > 4",
      "severity": "warning",
      "notification": "slack"
    },
    {
      "name": "Database Connection Pool Exhausted",
      "condition": "awkward_db_connections_active >= awkward_db_connections_max * 0.9",
      "severity": "critical",
      "notification": "pagerduty"
    }
  ]
}